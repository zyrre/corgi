#!/usr/bin/env bash
# Shell tests for scripts/install.sh against a fake release and a fake `cargo`.
#
# Run directly: scripts/test-install
#
# Each test gets a fresh plugin checkout (the install script and a manifest)
# and a fake release directory served through CORGI_DOWNLOAD_URL as a file://
# URL. The fake cargo "builds" by writing a marker binary and appends one line
# to calls.log, so a test can tell a download from a source build without
# compiling anything.
#
# HOME is a fresh folder in each test, so linking the command never touches
# the real ~/.local/bin. A test that installs the way Herdr does puts the
# checkout at plugins/.tmp-install-*/checkout and afterwards moves it to
# plugins/github/<id>-<hash>, as Herdr does once the build passes.
#
# The fake release binary records every call but --version in calls.log, so
# `corgi daemon install` never reaches launchd or systemd, and the Herdr app
# installer finds OpenCode only where a test puts a fake one.
set -euo pipefail
unset XDG_BIN_HOME CORGI_BIN_DIR CORGI_LINK CORGI_BUILD XDG_CONFIG_HOME XDG_STATE_HOME \
  CORGI_OPENCODE_PLUGIN CORGI_OPENCODE_BIN

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
install_script="$script_dir/install.sh"
app_dir="$script_dir/../herdr-app"

failures=0
tests_run=0

work_root="$(mktemp -d "${TMPDIR:-/tmp}/corgi-install-test.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT

version=0.4.2
plugin_id=io.github.zyrre.corgi

# The fake release is served as a file:// URL, which only curl can fetch.
if ! command -v curl >/dev/null 2>&1; then
  echo "scripts/test-install needs curl" >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin) os=apple-darwin ;;
  *) os=unknown-linux-musl ;;
esac
case "$(uname -m)" in
  arm64 | aarch64) arch=aarch64 ;;
  *) arch=x86_64 ;;
esac
asset="corgi-$arch-$os"

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum "$1" | cut -d ' ' -f 1; }
else
  sha256() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
fi

# --- fixtures ---------------------------------------------------------------

# Prints a fresh state directory holding checkout/, release/ and bin/.
new_state() {
  local state="$work_root/$1"
  mkdir -p "$state/checkout/scripts" "$state/checkout/checksums" "$state/release" "$state/bin" "$state/home"
  cp "$install_script" "$state/checkout/scripts/install.sh"
  cp "$script_dir/link-command.sh" "$state/checkout/scripts/link-command.sh"
  printf 'id = "%s"\nversion = "%s"\n' "$plugin_id" "$version" >"$state/checkout/herdr-plugin.toml"
  : >"$state/calls.log"

  cat >"$state/bin/cargo" <<'FAKE_CARGO'
#!/bin/sh
printf 'cargo %s\n' "$*" >>"$FAKE_STATE/calls.log"
[ -z "${FAKE_CARGO_FAIL:-}" ] || exit 101
mkdir -p target/release
printf '#!/bin/sh\necho "corgi built from source"\n' >target/release/corgi
chmod 755 target/release/corgi
FAKE_CARGO
  chmod 755 "$state/bin/cargo"
  echo "$state"
}

# Publishes a release binary that reports $2 as its version, with a matching
# SHA256SUMS entry.
publish_release() {
  local state="$1" reports="$2" dir="$1/release/v$version"
  mkdir -p "$dir"
  cat >"$dir/$asset" <<'FAKE_CORGI'
#!/bin/sh
if [ "${1:-}" != --version ] && [ -n "${FAKE_STATE:-}" ]; then
  printf 'corgi %s\n' "$*" >>"$FAKE_STATE/calls.log"
fi
if [ "${1:-}" = app-space ]; then
  [ -z "${FAKE_SPACE_FAIL:-}" ] || { echo "corgi app-space: the window said no" >&2; exit 1; }
  if [ "${2:-}" = remove ]; then echo "removed the Corgi space"; else echo "made the Corgi space (sp1), first in the Spaces list"; fi
  exit 0
fi
if [ "${1:-}" = app-layout ]; then
  [ -z "${FAKE_LAYOUT_FAIL:-}" ] || { echo "corgi app-layout: no home" >&2; exit 1; }
  if [ "${2:-}" = remove ]; then echo "put Herdr's Spaces and Agents lists back in place of Corgi's Projects list in: corgi"; else echo "Herdr replaces its own main layout on its updates, so Corgi cloned it to corgi and put its Projects list in the sidebar; the window shows it"; fi
  exit 0
fi
FAKE_CORGI
  printf 'echo "%s"\n' "$reports" >>"$dir/$asset"
  printf '#!/bin/sh\necho "corgi %s"\n' "$version" >"$dir/corgi-other-target"
  {
    printf '%s  %s\n' "$(sha256 "$dir/corgi-other-target")" corgi-other-target
    printf '%s  %s\n' "$(sha256 "$dir/$asset")" "$asset"
  } >"$dir/SHA256SUMS"
  # Snapshot reviewed data before any test replaces mutable release content.
  printf 'v%s %s %s\n' "$version" "$(sha256 "$dir/$asset")" "$asset" \
    >"$state/checkout/checksums/v$version.sha256"
}

# Like new_state, but the checkout sits where Herdr builds an install;
# $state/checkout links to it.
new_herdr_state() {
  local state
  state="$(new_state "$1")"
  mkdir -p "$state/plugins/.tmp-install-123-456"
  mv "$state/checkout" "$state/plugins/.tmp-install-123-456/checkout"
  ln -s "$state/plugins/.tmp-install-123-456/checkout" "$state/checkout"
  echo "$state"
}

# Where Herdr moves the checkout once the build has passed.
final_checkout() {
  local hash
  hash="$(printf %s "$plugin_id" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c 1-12)"
  echo "$(cd "$1/plugins" && pwd -P)/github/$plugin_id-$hash"
}

# Does what Herdr does after a passing build.
finish_herdr_install() {
  local state="$1" final
  final="$(final_checkout "$state")"
  mkdir -p "$(dirname "$final")"
  mv "$state/plugins/.tmp-install-123-456/checkout" "$final"
  ln -sfn "$final" "$state/checkout"
}

# What the corgi command in bin folder $1 says, run through its link.
command_version() {
  "$1/corgi" --version 2>/dev/null || echo "no corgi command"
}

link_of() {
  if [[ -L "$1" ]]; then readlink "$1"; else echo "not a link"; fi
}

make_git_checkout() {
  local checkout="$1/checkout"
  git -C "$checkout" init -q
  git -C "$checkout" add .
  git -C "$checkout" -c user.name=test -c user.email=test@example.com commit -q -m release
  git -C "$checkout" tag "v$version"
  echo "# after the release" >>"$checkout/herdr-plugin.toml"
  git -C "$checkout" -c user.name=test -c user.email=test@example.com commit -q -am "past the release"
}

run_install() {
  local state="$1"
  FAKE_STATE="$state" \
  HOME="$state/home" \
  CORGI_DOWNLOAD_URL="file://$state/release" \
  PATH="$state/bin:$PATH" \
  sh "$state/checkout/scripts/install.sh" 2>"$state/stderr.log"
}

installed() {
  "$1/checkout/target/release/corgi" --version 2>/dev/null || echo "nothing installed"
}

count_cargo() {
  grep -c '^cargo build --release --locked$' "$1/calls.log" || true
}

leftover_downloads() {
  find "$1/checkout/target/release" -name '.download.*' 2>/dev/null | wc -l | tr -d ' '
}

check() {
  local description="$1" expected="$2" actual="$3"
  tests_run=$((tests_run + 1))
  if [[ "$expected" != "$actual" ]]; then
    echo "FAIL: $description (expected [$expected], got [$actual])" >&2
    failures=$((failures + 1))
  else
    echo "ok: $description"
  fi
}

check_stderr() {
  local description="$1" pattern="$2" state="$3"
  if grep -qF -- "$pattern" "$state/stderr.log"; then
    check "$description" found found
  else
    check "$description" "[$pattern] in stderr" "$(cat "$state/stderr.log")"
  fi
}

# --- test: the matching release binary is downloaded and verified ----------
test_downloads_release_binary() {
  local state status=0
  state="$(new_state download)"
  publish_release "$state" "corgi $version"

  run_install "$state" || status=$?
  check "download: exit status" "0" "$status"
  check "download: installs the release binary" "corgi $version" "$(installed "$state")"
  check "download: cargo not run" "0" "$(count_cargo "$state")"
  check "download: no download folder left behind" "0" "$(leftover_downloads "$state")"
  check_stderr "download: says what it installed" "installed the prebuilt $asset v$version" "$state"
}

# Like make_git_checkout, without the commit past the release tag.
make_git_checkout_on_tag() {
  local checkout="$1/checkout"
  git -C "$checkout" init -q
  git -C "$checkout" add .
  git -C "$checkout" -c user.name=test -c user.email=test@example.com commit -q -m release
  git -C "$checkout" tag "v$version"
}

# --- test: a clean checkout past the release tag builds from source --------
test_checkout_past_tag_builds_from_source() {
  local state status=0
  state="$(new_state past-tag)"
  publish_release "$state" "corgi $version"
  make_git_checkout "$state"

  run_install "$state" || status=$?
  check "past tag: exit status" "0" "$status"
  check "past tag: builds from source" "corgi built from source" "$(installed "$state")"
  check "past tag: cargo run once" "1" "$(count_cargo "$state")"
  check_stderr "past tag: says why" "this checkout is not on the release tag v$version" "$state"
}

# --- test: a checkout on the release tag downloads -------------------------
test_checkout_on_tag_downloads() {
  local state status=0
  state="$(new_state on-tag)"
  publish_release "$state" "corgi $version"
  make_git_checkout_on_tag "$state"

  run_install "$state" || status=$?
  check "on tag: exit status" "0" "$status"
  check "on tag: installs the release binary" "corgi $version" "$(installed "$state")"
  check "on tag: cargo not run" "0" "$(count_cargo "$state")"

  # A checkout with no tag at all (a shallow clone) is not on the release.
  status=0
  state="$(new_state no-tag)"
  publish_release "$state" "corgi $version"
  make_git_checkout_on_tag "$state"
  git -C "$state/checkout" tag -d "v$version" >/dev/null
  run_install "$state" || status=$?
  check "no tag: builds from source" "corgi built from source" "$(installed "$state")"
}

# --- test: CORGI_BUILD overrides the choice both ways ----------------------
test_build_override() {
  local state status=0
  state="$(new_state override-release)"
  publish_release "$state" "corgi $version"
  make_git_checkout "$state"
  CORGI_BUILD=release run_install "$state" || status=$?
  check "release override, past tag: exit status" "0" "$status"
  check "release override, past tag: downloads" "corgi $version" "$(installed "$state")"
  check "release override, past tag: cargo not run" "0" "$(count_cargo "$state")"

  status=0
  state="$(new_state override-source)"
  publish_release "$state" "corgi $version"
  make_git_checkout_on_tag "$state"
  CORGI_BUILD=source run_install "$state" || status=$?
  check "source override, on tag: exit status" "0" "$status"
  check "source override, on tag: builds" "corgi built from source" "$(installed "$state")"
  check "source override, on tag: cargo run once" "1" "$(count_cargo "$state")"

  # Forcing the download does not trust a dirty tree, and an unknown value is ignored.
  status=0
  state="$(new_state override-dirty)"
  publish_release "$state" "corgi $version"
  make_git_checkout_on_tag "$state"
  echo "# local edit" >>"$state/checkout/scripts/install.sh"
  CORGI_BUILD=release run_install "$state" || status=$?
  check "release override, dirty: builds" "corgi built from source" "$(installed "$state")"

  status=0
  state="$(new_state override-unknown)"
  publish_release "$state" "corgi $version"
  make_git_checkout "$state"
  CORGI_BUILD=nonsense run_install "$state" || status=$?
  check "unknown override: builds like the default" "corgi built from source" "$(installed "$state")"
  check_stderr "unknown override: says it is ignored" "ignoring CORGI_BUILD=nonsense" "$state"
}

# --- test: Herdr's own plugin install downloads whatever its HEAD ----------
test_herdr_checkout_past_tag_downloads() {
  local state status=0
  state="$(new_herdr_state herdr-past-tag)"
  publish_release "$state" "corgi $version"
  make_git_checkout "$state"

  run_install "$state" || status=$?
  check "herdr past tag: exit status" "0" "$status"
  check "herdr past tag: installs the release binary" "corgi $version" "$(installed "$state")"
  check "herdr past tag: cargo not run" "0" "$(count_cargo "$state")"
}

# --- test: uncommitted changes build from source ---------------------------
test_dirty_checkout_builds_from_source() {
  local state status=0
  state="$(new_state dirty)"
  publish_release "$state" "corgi $version"
  make_git_checkout "$state"
  echo "# local edit" >>"$state/checkout/scripts/install.sh"

  run_install "$state" || status=$?
  check "dirty checkout: exit status" "0" "$status"
  check "dirty checkout: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "dirty checkout: says why" "this checkout has uncommitted changes" "$state"
}

# --- test: CORGI_BUILD=source skips the download ---------------------------
test_forced_source_build() {
  local state status=0
  state="$(new_state forced-source)"
  publish_release "$state" "corgi $version"

  CORGI_BUILD=source run_install "$state" || status=$?
  check "forced source: exit status" "0" "$status"
  check "forced source: builds from source" "corgi built from source" "$(installed "$state")"
  check "forced source: cargo run once" "1" "$(count_cargo "$state")"
  check_stderr "forced source: says why" "CORGI_BUILD=source is set" "$state"
}

# --- test: a checksum mismatch builds from source --------------------------
test_checksum_mismatch_builds_from_source() {
  local state status=0
  state="$(new_state checksum)"
  publish_release "$state" "corgi $version"
  echo "tampered" >>"$state/release/v$version/$asset"

  run_install "$state" || status=$?
  check "checksum mismatch: exit status" "0" "$status"
  check "checksum mismatch: builds from source" "corgi built from source" "$(installed "$state")"
  check "checksum mismatch: no download folder left behind" "0" "$(leftover_downloads "$state")"
  check_stderr "checksum mismatch: says why" "does not match its reviewed checksum pin" "$state"
}

# --- test: a release without this platform's binary builds from source -----
test_missing_asset_builds_from_source() {
  local state status=0
  state="$(new_state missing-asset)"
  publish_release "$state" "corgi $version"
  rm "$state/release/v$version/$asset"

  run_install "$state" || status=$?
  check "missing asset: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "missing asset: says why" "could not download" "$state"
}

# --- test: no release for this version builds from source ------------------
test_missing_release_builds_from_source() {
  local state status=0
  state="$(new_state missing-release)"
  publish_release "$state" "corgi $version"
  rm -rf "$state/release/v$version"

  run_install "$state" || status=$?
  check "missing release: exit status" "0" "$status"
  check "missing release: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "missing release: says why" "could not download" "$state"
}

# --- test: a binary reporting another version builds from source -----------
test_wrong_version_builds_from_source() {
  local state status=0
  state="$(new_state wrong-version)"
  publish_release "$state" "corgi 0.0.1"

  run_install "$state" || status=$?
  check "wrong version: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "wrong version: says why" "is not $version (it said: corgi 0.0.1)" "$state"
}

# --- test: a binary that names its commit after the version is that version --
test_version_with_commit() {
  local state status reports
  for reports in "corgi $version (5b50895)" "corgi $version (5b50895, modified)"; do
    status=0
    state="$(new_state version-commit)"
    publish_release "$state" "$reports"
    run_install "$state" || status=$?
    check "version with commit: exit status ($reports)" "0" "$status"
    check "version with commit: installs the release binary" "$reports" "$(installed "$state")"
    check "version with commit: cargo not run" "0" "$(count_cargo "$state")"
  done
  # Only a commit in brackets may follow: a longer version is another one.
  for reports in "corgi ${version}0" "corgi $version-rc1" "corgi $version (5b50895) and more"; do
    state="$(new_state version-commit-wrong)"
    publish_release "$state" "$reports"
    run_install "$state" || true
    check "version with commit: $reports builds from source" "corgi built from source" "$(installed "$state")"
  done
}

# A matching remote checksum must never authorize replacement bytes, even
# when they claim the correct version. The marker catches execution at --version.
test_replaced_remote_artifacts() {
  local state status=0
  state="$(new_state replacement-attack)"
  publish_release "$state" "corgi $version"
  cat >"$state/release/v$version/$asset" <<'ATTACKER'
#!/bin/sh
touch "$HOME/replacement-executed"
echo "corgi 0.4.2"
ATTACKER
  printf '%s  %s\n' "$(sha256 "$state/release/v$version/$asset")" "$asset" \
    >"$state/release/v$version/SHA256SUMS"

  run_install "$state" || status=$?
  check "replacement attack: exit status" 0 "$status"
  check "replacement attack: never executes replacement" no \
    "$([[ -e "$state/home/replacement-executed" ]] && echo yes || echo no)"
  check "replacement attack: source build" 1 "$(count_cargo "$state")"
  check "replacement attack: installed source bytes" "corgi built from source" "$(installed "$state")"
  check_stderr "replacement attack: rejects local pin mismatch" "does not match its reviewed checksum pin" "$state"
}

# Untrusted pin data cannot reach even --version, or a later command link.
test_invalid_pins() {
  local state kind pins status
  for kind in missing empty malformed short-hash invalid-hex duplicate conflicting wrong-version wrong-asset missing-platform extra-field malformed-other; do
    state="$(new_herdr_state "pin-$kind")"
    publish_release "$state" "corgi $version"
    # Marker-bearing remote bytes remain unauthorized regardless of pin failure.
    # shellcheck disable=SC2016 # HOME must expand only if the payload executes.
    printf '#!/bin/sh\ntouch "$HOME/replacement-executed"\necho "corgi %s"\n' "$version" \
      >"$state/release/v$version/$asset"
    printf '%s  %s\n' "$(sha256 "$state/release/v$version/$asset")" "$asset" \
      >"$state/release/v$version/SHA256SUMS"
    pins="$state/checkout/checksums/v$version.sha256"
    # Pin the exact marker-bearing bytes first, then invalidate only trust data.
    printf 'v%s %s %s\n' "$version" "$(sha256 "$state/release/v$version/$asset")" "$asset" >"$pins"
    case "$kind" in
      missing) rm "$pins" ;;
      empty) : >"$pins" ;;
      malformed) echo 'not a pin' >"$pins" ;;
      short-hash) printf 'v%s abc %s\n' "$version" "$asset" >"$pins" ;;
      invalid-hex) sed 's/ [0-9a-f]/ z/' "$pins" >"$state/edit"; mv "$state/edit" "$pins" ;;
      duplicate) cat "$pins" >"$state/copy"; cat "$state/copy" >>"$pins" ;;
      conflicting) printf 'v%s %064d %s\n' "$version" 0 "$asset" >>"$pins" ;;
      wrong-version) sed "s/v$version /v0.0.1 /" "$pins" >"$state/edit"; mv "$state/edit" "$pins" ;;
      wrong-asset) sed "s/$asset/corgi-other-target/" "$pins" >"$state/edit"; mv "$state/edit" "$pins" ;;
      missing-platform) printf 'v%s %064d corgi-aarch64-apple-darwin\n' "$version" 0 >"$pins"
        if [[ "$asset" == corgi-aarch64-apple-darwin ]]; then
          sed 's/aarch64/x86_64/' "$pins" >"$state/edit"; mv "$state/edit" "$pins"
        fi ;;
      extra-field) sed 's/$/ extra/' "$pins" >"$state/edit"; mv "$state/edit" "$pins" ;;
      malformed-other) echo 'invalid unrelated entry' >>"$pins" ;;
    esac
    status=0
    run_install "$state" || status=$?
    check "pin $kind: exit status" 0 "$status"
    check "pin $kind: never executes remote bytes" no \
      "$([[ -e "$state/home/replacement-executed" ]] && echo yes || echo no)"
    check "pin $kind: builds local source" 1 "$(count_cargo "$state")"
    finish_herdr_install "$state"
    check "pin $kind: links source binary" "corgi built from source" "$(command_version "$state/home/.local/bin")"
    check_stderr "pin $kind: explains fallback" "reviewed checksum pin" "$state"
  done
}

# Remote sums have no authority, and are not required for trusted downloads.
test_remote_sums_not_required() {
  local state kind status
  for kind in absent malformed; do
    state="$(new_state "remote-sums-$kind")"
    publish_release "$state" "corgi $version"
    if [[ "$kind" == absent ]]; then
      rm "$state/release/v$version/SHA256SUMS"
    else
      echo 'untrusted nonsense' >"$state/release/v$version/SHA256SUMS"
    fi
    status=0
    run_install "$state" || status=$?
    check "remote sums $kind: exit status" 0 "$status"
    check "remote sums $kind: trusted download" "corgi $version" "$(installed "$state")"
    check "remote sums $kind: no source build" 0 "$(count_cargo "$state")"
  done
}

# --- test: a failing cargo build fails the install --------------------------
test_cargo_failure_fails_install() {
  local state status=0
  state="$(new_state cargo-fails)"

  FAKE_CARGO_FAIL=1 CORGI_BUILD=source run_install "$state" || status=$?
  check "cargo fails: exit status is cargo's" "101" "$status"
}

# --- test: building from source without cargo says so ----------------------
test_no_cargo_fails_clearly() {
  if [ -e /usr/bin/cargo ] || [ -e /bin/cargo ]; then
    echo "skip: no cargo (cargo is installed system-wide)"
    return
  fi
  local state status=0
  state="$(new_state no-cargo)"
  rm "$state/bin/cargo"

  CORGI_BUILD=source PATH="/usr/bin:/bin" run_install "$state" || status=$?
  check "no cargo: exits non-zero" "1" "$status"
  check_stderr "no cargo: says cargo is missing" "cargo is not installed" "$state"
}

# --- test: a Herdr install links the command to the final checkout ---------
test_herdr_install_links_command() {
  local state status=0 bin
  state="$(new_herdr_state link)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"

  run_install "$state" || status=$?
  check "link: exit status" "0" "$status"
  check "link: links the final checkout's binary by its absolute path" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$bin/corgi")"
  check_stderr "link: says the folder is not on PATH" \
    "linked $bin/corgi, but $bin is not on your PATH" "$state"
  finish_herdr_install "$state"
  check "link: corgi --version runs through the link" "corgi $version" "$(command_version "$bin")"
}

# --- test: a source build links the command too ----------------------------
test_source_build_links_command() {
  local state status=0 bin
  state="$(new_herdr_state link-source)"
  bin="$state/home/.local/bin"

  CORGI_BUILD=source run_install "$state" || status=$?
  finish_herdr_install "$state"
  check "link after source build: exit status" "0" "$status"
  check "link after source build: runs the built binary" \
    "corgi built from source" "$(command_version "$bin")"
}

# --- test: no PATH hint when the folder is on PATH -------------------------
test_link_on_path_has_no_hint() {
  local state status=0
  state="$(new_herdr_state link-on-path)"
  publish_release "$state" "corgi $version"

  PATH="$state/home/.local/bin:$PATH" run_install "$state" || status=$?
  check "on PATH: exit status" "0" "$status"
  check "on PATH: no hint" "0" "$(grep -c 'not on your PATH' "$state/stderr.log" || true)"
  check_stderr "on PATH: says it linked" "linked $state/home/.local/bin/corgi" "$state"
}

# --- test: a link to an older install is replaced --------------------------
test_link_to_older_install_replaced() {
  local state status=0 bin
  state="$(new_herdr_state link-older)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  ln -s "$(cd "$state/plugins" && pwd -P)/github/old-checkout/target/release/corgi" "$bin/corgi"

  run_install "$state" || status=$?
  check "older link: exit status" "0" "$status"
  check "older link: now links the new checkout" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$bin/corgi")"
}

# --- test: a broken link elsewhere is replaced, a working one is kept ------
test_links_elsewhere() {
  local state status=0 bin
  state="$(new_herdr_state link-broken)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  ln -s "$state/gone/corgi" "$bin/corgi"

  run_install "$state" || status=$?
  check "broken link: exit status" "0" "$status"
  check "broken link: replaced" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$bin/corgi")"

  status=0
  state="$(new_herdr_state link-working)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  printf '#!/bin/sh\necho "my own corgi"\n' >"$state/my-corgi"
  chmod 755 "$state/my-corgi"
  ln -s "$state/my-corgi" "$bin/corgi"

  run_install "$state" || status=$?
  check "working link: exit status" "0" "$status"
  check "working link: kept" "$state/my-corgi" "$(link_of "$bin/corgi")"
  check_stderr "working link: says so" "left $bin/corgi alone: it links $state/my-corgi" "$state"
}

# --- test: a file or a folder in the way is left alone ---------------------
test_file_or_folder_left_alone() {
  local state status=0 bin
  state="$(new_herdr_state link-file)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  echo "mine" >"$bin/corgi"

  run_install "$state" || status=$?
  check "file in the way: exit status" "0" "$status"
  check "file in the way: installs anyway" "corgi $version" "$(installed "$state")"
  check "file in the way: kept" "mine" "$(cat "$bin/corgi")"
  check_stderr "file in the way: says so" "left $bin/corgi alone: it is not a link" "$state"

  status=0
  state="$(new_herdr_state link-folder)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin/corgi"

  run_install "$state" || status=$?
  check "folder in the way: exit status" "0" "$status"
  check "folder in the way: kept" "folder" "$([[ -d "$bin/corgi" && ! -L "$bin/corgi" ]] && echo folder)"
  check "folder in the way: nothing linked inside it" "0" "$(find "$bin/corgi" -mindepth 1 | wc -l | tr -d ' ')"
}

# --- test: CORGI_LINK=0 and CORGI_BIN_DIR ----------------------------------
test_link_opt_out_and_override() {
  local state status=0
  state="$(new_herdr_state link-opt-out)"
  publish_release "$state" "corgi $version"

  CORGI_LINK=0 run_install "$state" || status=$?
  check "CORGI_LINK=0: exit status" "0" "$status"
  check "CORGI_LINK=0: nothing linked" "no" "$([[ -e "$state/home/.local" ]] && echo yes || echo no)"

  status=0
  state="$(new_herdr_state link-override)"
  publish_release "$state" "corgi $version"

  CORGI_BIN_DIR="$state/my bin" run_install "$state" || status=$?
  check "CORGI_BIN_DIR: exit status" "0" "$status"
  check "CORGI_BIN_DIR: links there" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$state/my bin/corgi")"
  check "CORGI_BIN_DIR: not in ~/.local/bin" "no" "$([[ -e "$state/home/.local" ]] && echo yes || echo no)"
}

# --- test: a link that cannot be made only warns ---------------------------
test_link_failure_only_warns() {
  local state status=0
  state="$(new_herdr_state link-fails)"
  publish_release "$state" "corgi $version"
  echo "not a folder" >"$state/home/.local"

  run_install "$state" || status=$?
  check "link fails: exit status" "0" "$status"
  check "link fails: installs anyway" "corgi $version" "$(installed "$state")"
  check_stderr "link fails: says so" "could not link $state/home/.local/bin/corgi" "$state"
}

# --- test: outside a Herdr install nothing is linked -----------------------
test_no_link_outside_herdr() {
  local state status=0
  state="$(new_state link-outside)"
  publish_release "$state" "corgi $version"

  run_install "$state" || status=$?
  check "outside Herdr: exit status" "0" "$status"
  check "outside Herdr: nothing linked" "no" "$([[ -e "$state/home/.local" ]] && echo yes || echo no)"
}

# --- the Herdr app: herdr-app/install.sh -------------------------------------

# Like new_state, with the Herdr app's installer and mods in the checkout and a
# fake herdr-app in bin/ whose `check` logs the folder, writes what the real
# one writes into it, and fails when FAKE_CHECK_FAIL is set.
new_app_state() {
  local state
  state="$(new_state "$1")"
  mkdir -p "$state/checkout/herdr-app/mods/corgi" "$state/checkout/herdr-app/mods/projects"
  cp "$app_dir/install.sh" "$state/checkout/herdr-app/install.sh"
  cp "$app_dir/mods/corgi/main.js" "$app_dir/mods/corgi/mod.json" "$state/checkout/herdr-app/mods/corgi/"
  cp "$app_dir/mods/projects/main.js" "$app_dir/mods/projects/mod.json" "$state/checkout/herdr-app/mods/projects/"
  mkdir -p "$state/checkout/herdr-app/opencode"
  cp "$app_dir/opencode/corgi-hc-status.js" "$state/checkout/herdr-app/opencode/"
  cat >"$state/bin/herdr-app" <<'FAKE_APP'
#!/bin/sh
case $1 in
  --version) echo "herdr-app 0.1.14" ;;
  check)
    printf 'herdr-app check %s\n' "$2" >>"$FAKE_STATE/calls.log"
    : >"$2/jsconfig.json"
    : >"$2/gpui-kit.d.ts"
    [ -z "${FAKE_CHECK_FAIL:-}" ] || { echo "main.js: SyntaxError" >&2; exit 1; }
    echo "check passed: $2"
    ;;
  *) exit 2 ;;
esac
FAKE_APP
  chmod 755 "$state/bin/herdr-app"
  echo "$state"
}

run_app_install() {
  local state="$1"
  shift
  FAKE_STATE="$state" \
  HOME="$state/home" \
  CORGI_DOWNLOAD_URL="file://$state/release" \
  CORGI_OPENCODE_BIN="${CORGI_OPENCODE_BIN:-$state/bin/opencode}" \
  PATH="$state/bin:$PATH" \
  sh "$state/checkout/herdr-app/install.sh" "$@" 2>"$state/stderr.log"
}

# How many times the installed corgi ran `daemon $2`.
count_daemon() { grep -c "^corgi daemon $2\$" "$1/calls.log" || true; }

app_mod() { echo "$1/home/.config/herdr-app/mods/corgi"; }
projects_mod() { echo "$1/home/.config/herdr-app/mods/projects"; }
# The `corgi app-layout` calls, one per line.
layout_calls() { grep '^corgi app-layout' "$1/calls.log" || true; }
real_checkout() { (cd "$1/checkout" && pwd -P); }
count_checks() { grep -c '^herdr-app check ' "$1/calls.log" || true; }
# The `corgi app-space` calls, one per line.
space_calls() { grep '^corgi app-space' "$1/calls.log" || true; }

# --- test: the CLI from the pinned release, linked, and the mod checked in --
test_app_install() {
  local state status=0 mod projects bin stage
  state="$(new_app_state app)"
  publish_release "$state" "corgi $version"
  mod="$(app_mod "$state")"
  projects="$(projects_mod "$state")"
  bin="$(real_checkout "$state")/target/release/corgi"
  stage="$state/home/.config/herdr-app/mods/.corgi-install"

  run_app_install "$state" || status=$?
  check "app: exit status" "0" "$status"
  check "app: installs the release binary" "corgi $version" "$(installed "$state")"
  check "app: cargo not run" "0" "$(count_cargo "$state")"
  check "app: links the command" "$bin" "$(link_of "$state/home/.local/bin/corgi")"
  check "app: copies the mod" "yes" "$([[ -f "$mod/main.js" && -f "$mod/mod.json" ]] && echo yes || echo no)"
  check "app: names the CLI for the mod" "{ \"corgi\": \"$bin\" }" "$(cat "$mod/config.json" 2>/dev/null)"
  check "app: copies the Projects mod" "yes" "$([[ -f "$projects/main.js" && -f "$projects/mod.json" ]] && echo yes || echo no)"
  check "app: names the CLI for the Projects mod" "{ \"corgi\": \"$bin\" }" "$(cat "$projects/config.json" 2>/dev/null)"
  check "app: checks each mod before it goes in, the Projects mod first" \
    "herdr-app check $stage/projects|herdr-app check $stage/corgi" \
    "$(grep '^herdr-app check' "$state/calls.log" | tr '\n' '|' | sed 's/|$//')"
  check "app: leaves what check writes out" "no" \
    "$([[ -e "$mod/jsconfig.json" || -e "$mod/gpui-kit.d.ts" || -e "$projects/jsconfig.json" || -e "$projects/gpui-kit.d.ts" ]] && echo yes || echo no)"
  check "app: no staging folder left" "no" "$([[ -e "$stage" ]] && echo yes || echo no)"
  check_stderr "app: says it installed the mod" "installed the Corgi mod in $mod" "$state"
  check_stderr "app: says it installed the Projects mod" "installed the Projects mod in $projects" "$state"
  check "app: puts the Projects list into the layout of the app's home, asking its window" \
    "corgi app-layout --app $state/bin/herdr-app --home $state/home/.config/herdr-app" "$(layout_calls "$state")"
  check "app: after the mods are in" "herdr-app check|herdr-app check|corgi app-layout" \
    "$(grep -E '^(herdr-app check|corgi app-layout)' "$state/calls.log" | cut -d ' ' -f 1-2 | tr '\n' '|' | sed 's/|$//')"
  check_stderr "app: says what corgi did to the layout" \
    "so Corgi cloned it to corgi and put its Projects list in the sidebar" "$state"
  check "app: installs the daemon with the new binary" "1" "$(count_daemon "$state" install)"
  check_stderr "app: says the daemon runs" "the corgi daemon runs as a service" "$state"
  # The Corgi space is retired: only `corgi app-space`, by hand, makes one.
  check "app: makes no Corgi space" "" "$(space_calls "$state")"
  check "app: and says nothing of one" "0" "$(grep -c 'Corgi space' "$state/stderr.log" || true)"
  check "app: no OpenCode, no question and no plugin" "no" \
    "$([[ -e "$state/home/.config/opencode" || -e "$state/home/.local/state/corgi/opencode-plugin" ]] && echo yes || echo no)"

  # Run again: an unchanged mod is not touched, so the app does not reload it.
  : >"$mod/.marker"
  : >"$projects/.marker"
  status=0
  run_app_install "$state" || status=$?
  check "app again: exit status" "0" "$status"
  check "app again: the daemon is installed again, to restart it" "2" "$(count_daemon "$state" install)"
  check "app again: unchanged mods left in place" "yes yes" \
    "$([[ -e "$mod/.marker" ]] && echo yes || echo no) $([[ -e "$projects/.marker" ]] && echo yes || echo no)"
  check_stderr "app again: says so" "the Corgi mod in $mod is up to date" "$state"
  check_stderr "app again: of the Projects mod too" "the Projects mod in $projects is up to date" "$state"
  check "app again: asks for the layout again (corgi app-layout then changes nothing)" "2" \
    "$(layout_calls "$state" | wc -l | tr -d ' ')"
  check "app again: still no Corgi space" "" "$(space_calls "$state")"

  # A layout corgi cannot change fails no install.
  status=0
  FAKE_LAYOUT_FAIL=1 run_app_install "$state" || status=$?
  check "app layout fails: exit status" "0" "$status"
  check_stderr "app layout fails: shows why" "corgi app-layout: no home" "$state"
  check_stderr "app layout fails: says how to try again" "could not put the Projects list into the layout; run" "$state"

  # A changed mod is swapped in whole, and the other is left.
  echo "// changed" >>"$state/checkout/herdr-app/mods/corgi/main.js"
  status=0
  run_app_install "$state" || status=$?
  check "app update: exit status" "0" "$status"
  check "app update: new mod in place" "// changed" "$(tail -n 1 "$mod/main.js")"
  check "app update: the old folder is gone" "no" "$([[ -e "$mod/.marker" ]] && echo yes || echo no)"
  check "app update: the unchanged Projects mod is left" "yes" "$([[ -e "$projects/.marker" ]] && echo yes || echo no)"
  echo "// changed" >>"$state/checkout/herdr-app/mods/projects/main.js"
  status=0
  run_app_install "$state" || status=$?
  check "app update: new Projects mod in place" "// changed" "$(tail -n 1 "$projects/main.js")"
  check "app update: its old folder is gone" "no" "$([[ -e "$projects/.marker" ]] && echo yes || echo no)"
  check "app update: no staging folder left" "no" "$([[ -e "$stage" ]] && echo yes || echo no)"
}

# --- test: a failing check, a folder that is not ours, another version ----------
test_app_install_refusals() {
  local state status=0 mod
  state="$(new_app_state app-check-fails)"
  publish_release "$state" "corgi $version"
  mod="$(app_mod "$state")"

  FAKE_CHECK_FAIL=1 run_app_install "$state" || status=$?
  check "check fails: exit status" "1" "$status"
  check "check fails: no mod installed" "no no" \
    "$([[ -e "$mod" ]] && echo yes || echo no) $([[ -e "$(projects_mod "$state")" ]] && echo yes || echo no)"
  check "check fails: the layout left alone" "" "$(layout_calls "$state")"
  check_stderr "check fails: shows the error" "main.js: SyntaxError" "$state"

  status=0
  state="$(new_app_state app-not-ours)"
  publish_release "$state" "corgi $version"
  mod="$(app_mod "$state")"
  mkdir -p "$mod"
  echo "someone else's" >"$mod/main.js"
  run_app_install "$state" || status=$?
  check "not ours: exit status" "1" "$status"
  check "not ours: kept" "someone else's" "$(cat "$mod/main.js")"

  # A mod of the person's own called projects is theirs.
  status=0
  state="$(new_app_state app-projects-not-ours)"
  publish_release "$state" "corgi $version"
  mod="$(projects_mod "$state")"
  mkdir -p "$mod"
  echo "// my own projects mod" >"$mod/main.js"
  run_app_install "$state" || status=$?
  check "projects not ours: exit status" "1" "$status"
  check "projects not ours: kept" "// my own projects mod" "$(cat "$mod/main.js")"
  check_stderr "projects not ours: says so" "$mod exists and is not Corgi's mod; not overwriting it" "$state"
  check "projects not ours: no layout that would show it" "" "$(layout_calls "$state")"

  status=0
  state="$(new_app_state app-other-version)"
  publish_release "$state" "corgi $version"
  run_app_install "$state" --version 9.9.9 || status=$?
  check "other version: exit status" "1" "$status"
  check "other version: installs nothing" "nothing installed" "$(installed "$state")"
  check_stderr "other version: says why" "this checkout is Corgi $version, not 9.9.9" "$state"

  status=0
  state="$(new_app_state app-same-version)"
  publish_release "$state" "corgi $version"
  run_app_install "$state" --version "v$version" || status=$?
  check "own version: exit status" "0" "$status"
}

# --- test: --home, --cli-only, --mod-only, and a link left alone -------------
test_app_install_options() {
  local state status=0 home bin
  state="$(new_app_state app-home)"
  publish_release "$state" "corgi $version"
  home="$state/elsewhere"
  run_app_install "$state" --home "$home" || status=$?
  check "--home: exit status" "0" "$status"
  check "--home: the mod goes there" "yes" "$([[ -f "$home/mods/corgi/main.js" ]] && echo yes || echo no)"
  check "--home: the Projects mod too" "yes" "$([[ -f "$home/mods/projects/main.js" ]] && echo yes || echo no)"
  check "--home: not in the default home" "no" "$([[ -e "$(app_mod "$state")" ]] && echo yes || echo no)"
  check "--home: the layout in that home" "corgi app-layout --app $state/bin/herdr-app --home $home" "$(layout_calls "$state")"
  check "--home: no Corgi space there either" "" "$(space_calls "$state")"

  status=0
  state="$(new_app_state app-cli-only)"
  publish_release "$state" "corgi $version"
  run_app_install "$state" --cli-only || status=$?
  check "--cli-only: exit status" "0" "$status"
  check "--cli-only: installs the CLI" "corgi $version" "$(installed "$state")"
  check "--cli-only: no Corgi mod (it is the one running this)" "no" "$([[ -e "$(app_mod "$state")" ]] && echo yes || echo no)"
  check "--cli-only: the Projects mod, checked" "yes 1" \
    "$([[ -f "$(projects_mod "$state")/main.js" ]] && echo yes || echo no) $(count_checks "$state")"
  check "--cli-only: the layout" "corgi app-layout --app $state/bin/herdr-app --home $state/home/.config/herdr-app" "$(layout_calls "$state")"
  check "--cli-only: installs the daemon" "1" "$(count_daemon "$state" install)"
  check "--cli-only: no Corgi space" "" "$(space_calls "$state")"

  # With no Herdr app to check a mod with, the CLI still goes in.
  status=0
  state="$(new_app_state app-cli-only-no-app)"
  publish_release "$state" "corgi $version"
  rm "$state/bin/herdr-app"
  HERDR_APP_BIN="$state/bin/herdr-app" PATH="$state/bin:/usr/bin:/bin" run_app_install "$state" --cli-only || status=$?
  check "--cli-only, no app: exit status" "0" "$status"
  check "--cli-only, no app: installs the CLI" "corgi $version" "$(installed "$state")"
  check "--cli-only, no app: no Projects mod and no layout" "no " \
    "$([[ -e "$(projects_mod "$state")" ]] && echo yes || echo no) $(layout_calls "$state")"
  check_stderr "--cli-only, no app: says so" "the Projects mod and the layout are not installed" "$state"

  status=0
  state="$(new_app_state app-no-daemon)"
  publish_release "$state" "corgi $version"
  run_app_install "$state" --no-daemon || status=$?
  check "--no-daemon: exit status" "0" "$status"
  check "--no-daemon: leaves the daemon alone" "0" "$(count_daemon "$state" install)"

  status=0
  state="$(new_app_state app-mod-only)"
  publish_release "$state" "corgi $version"
  run_app_install "$state" --mod-only || status=$?
  check "--mod-only: exit status" "0" "$status"
  check "--mod-only: installs no CLI" "nothing installed" "$(installed "$state")"
  check "--mod-only: and no daemon" "0" "$(count_daemon "$state" install)"
  check "--mod-only: the mod without config.json" "yes no" \
    "$([[ -f "$(app_mod "$state")/main.js" ]] && echo yes || echo no) $([[ -e "$(app_mod "$state")/config.json" ]] && echo yes || echo no)"
  check "--mod-only: the Projects mod without config.json" "yes no" \
    "$([[ -f "$(projects_mod "$state")/main.js" ]] && echo yes || echo no) $([[ -e "$(projects_mod "$state")/config.json" ]] && echo yes || echo no)"
  check_stderr "--mod-only: with no corgi, says the layout waits for one" "to put the Projects list into the layout with" "$state"
  check "--mod-only: says nothing of a Corgi space" "0" "$(grep -c 'Corgi space' "$state/stderr.log" || true)"

  status=0
  state="$(new_app_state app-link-elsewhere)"
  publish_release "$state" "corgi $version"
  bin="$state/home/.local/bin"
  mkdir -p "$bin"
  printf '#!/bin/sh\necho "corgi from the plugin"\n' >"$state/plugin-corgi"
  chmod 755 "$state/plugin-corgi"
  ln -s "$state/plugin-corgi" "$bin/corgi"
  run_app_install "$state" || status=$?
  check "link elsewhere: exit status" "0" "$status"
  check "link elsewhere: kept" "$state/plugin-corgi" "$(link_of "$bin/corgi")"
  check_stderr "link elsewhere: says the mod runs its own" \
    "left $bin/corgi alone: it links $state/plugin-corgi; the mod runs $(real_checkout "$state")/target/release/corgi" "$state"
}

# --- test: --uninstall removes the mod, and the link only with --cli -----------
test_app_uninstall() {
  local state status=0 mod link
  state="$(new_app_state app-uninstall)"
  publish_release "$state" "corgi $version"
  mod="$(app_mod "$state")"
  link="$state/home/.local/bin/corgi"
  run_app_install "$state" || status=$?
  check "uninstall: the install made no Corgi space" "" "$(space_calls "$state")"

  run_app_install "$state" --uninstall || status=$?
  check "uninstall: exit status" "0" "$status"
  check "uninstall: mods removed" "no no" \
    "$([[ -e "$mod" ]] && echo yes || echo no) $([[ -e "$(projects_mod "$state")" ]] && echo yes || echo no)"
  check "uninstall: daemon removed" "1" "$(count_daemon "$state" uninstall)"
  check "uninstall: closes a Corgi space made by hand, then puts Spaces back in the layouts, first" \
    "corgi app-space remove --home $state/home/.config/herdr-app --app $state/bin/herdr-app|corgi app-layout remove --home $state/home/.config/herdr-app|corgi daemon uninstall" \
    "$(grep -A2 '^corgi app-space remove' "$state/calls.log" | tr '\n' '|' | sed 's/|$//')"
  check_stderr "uninstall: says where Spaces and Agents went back" "back in place of Corgi's Projects list in: corgi" "$state"

  # A space that cannot be closed fails no uninstall.
  status=0
  run_app_install "$state" || status=$?
  status=0
  FAKE_SPACE_FAIL=1 run_app_install "$state" --uninstall || status=$?
  check "uninstall, space fails: exit status" "0" "$status"
  check_stderr "uninstall, space fails: shows why" "the window said no" "$state"
  check_stderr "uninstall, space fails: says what to do" "could not close the Corgi space; close it in the Herdr app if there is one" "$state"
  check "uninstall, space fails: mods removed all the same" "no no" \
    "$([[ -e "$mod" ]] && echo yes || echo no) $([[ -e "$(projects_mod "$state")" ]] && echo yes || echo no)"
  check "uninstall: CLI link kept" "yes" "$([[ -L "$link" ]] && echo yes || echo no)"
  check "uninstall: CLI kept" "corgi $version" "$(installed "$state")"

  run_app_install "$state" --uninstall --cli || status=$?
  check "uninstall --cli: exit status" "0" "$status"
  check "uninstall --cli: link removed" "no" "$([[ -L "$link" ]] && echo yes || echo no)"
}

# --- test: OpenCode's status plugin, asked once, never forced ------------------
test_app_opencode_plugin() {
  local state status=0 plugin answer src
  state="$(new_app_state app-opencode)"
  publish_release "$state" "corgi $version"
  plugin="$state/home/.config/opencode/plugin/corgi-hc-status.js"
  answer="$state/home/.local/state/corgi/opencode-plugin"
  src="$state/checkout/herdr-app/opencode/corgi-hc-status.js"
  printf '#!/bin/sh\necho opencode 1.18.33\n' >"$state/bin/opencode"
  chmod 755 "$state/bin/opencode"

  # Nobody to ask: skipped, said, and nothing remembered.
  run_app_install "$state" || status=$?
  check "opencode unasked: exit status" "0" "$status"
  check "opencode unasked: no plugin" "no" "$([[ -e "$plugin" ]] && echo yes || echo no)"
  check "opencode unasked: no answer kept" "no" "$([[ -e "$answer" ]] && echo yes || echo no)"
  check_stderr "opencode unasked: says so" "skipped OpenCode's status plugin: no terminal to ask in" "$state"

  # Answered yes: installed, and the answer kept for the next run.
  status=0
  CORGI_OPENCODE_PLUGIN=yes run_app_install "$state" || status=$?
  check "opencode yes: exit status" "0" "$status"
  check "opencode yes: the plugin" "same" "$(cmp -s "$src" "$plugin" && echo same || echo differs)"
  check "opencode yes: the answer kept" "yes" "$(cat "$answer" 2>/dev/null)"
  echo "// changed" >>"$src"
  status=0
  run_app_install "$state" || status=$?
  check "opencode again: updated without asking" "same" "$(cmp -s "$src" "$plugin" && echo same || echo differs)"
  check "opencode again: nothing skipped" "0" "$(grep -c 'skipped OpenCode' "$state/stderr.log" || true)"

  # Answered no later: Corgi's plugin goes.
  status=0
  CORGI_OPENCODE_PLUGIN=no run_app_install "$state" || status=$?
  check "opencode no: exit status" "0" "$status"
  check "opencode no: plugin removed" "no" "$([[ -e "$plugin" ]] && echo yes || echo no)"
  check "opencode no: the answer kept" "no" "$(cat "$answer" 2>/dev/null)"

  # Someone else's file is never replaced.
  mkdir -p "$(dirname "$plugin")"
  echo "// my own plugin" >"$plugin"
  status=0
  CORGI_OPENCODE_PLUGIN=yes run_app_install "$state" || status=$?
  check "opencode not ours: kept" "// my own plugin" "$(cat "$plugin")"
  check_stderr "opencode not ours: says so" "left $plugin alone: it is not Corgi's" "$state"
  rm "$plugin"

  # An OpenCode that reports by itself needs none: Corgi's goes.
  CORGI_OPENCODE_PLUGIN=yes run_app_install "$state" || status=$?
  check "opencode reinstalled" "yes" "$([[ -f "$plugin" ]] && echo yes || echo no)"
  printf '#!/bin/sh\nprintf "\\033]7501;state=idle:app=opencode\\033\\\\"\n' >"$state/bin/opencode"
  status=0
  run_app_install "$state" || status=$?
  check "opencode native: exit status" "0" "$status"
  check "opencode native: plugin removed" "no" "$([[ -e "$plugin" ]] && echo yes || echo no)"
  check_stderr "opencode native: says why" "OpenCode reports its status to herdr-core itself" "$state"

  # --uninstall takes the plugin and the answer away.
  printf '#!/bin/sh\necho opencode 1.18.33\n' >"$state/bin/opencode"
  CORGI_OPENCODE_PLUGIN=yes run_app_install "$state" || status=$?
  status=0
  run_app_install "$state" --uninstall || status=$?
  check "opencode uninstall: exit status" "0" "$status"
  check "opencode uninstall: plugin and answer removed" "no no" \
    "$([[ -e "$plugin" ]] && echo yes || echo no) $([[ -e "$answer" ]] && echo yes || echo no)"

  # A plugin install (--mod-only) never asks or installs it.
  rm -rf "$state/home/.local/state/corgi"
  status=0
  CORGI_OPENCODE_PLUGIN=yes run_app_install "$state" --mod-only || status=$?
  check "opencode --mod-only: no plugin" "no" "$([[ -e "$plugin" ]] && echo yes || echo no)"
}

# --- test: a plugin install adds the mod when the Herdr app is installed -----
test_plugin_install_adds_app_mod() {
  local state status=0 mod
  state="$(new_app_state plugin-app)"
  publish_release "$state" "corgi $version"
  mod="$(app_mod "$state")"

  run_install "$state" || status=$?
  check "plugin with app: exit status" "0" "$status"
  check "plugin with app: installs the CLI" "corgi $version" "$(installed "$state")"
  check "plugin with app: adds the mod, without config.json" "yes no" \
    "$([[ -f "$mod/main.js" ]] && echo yes || echo no) $([[ -e "$mod/config.json" ]] && echo yes || echo no)"
  check "plugin with app: adds the Projects mod and puts it into the layout" "yes 1" \
    "$([[ -f "$(projects_mod "$state")/main.js" ]] && echo yes || echo no) $(layout_calls "$state" | wc -l | tr -d ' ')"
  check "plugin with app: makes no Corgi space" "" "$(space_calls "$state")"
  check_stderr "plugin with app: says so" "the Herdr app is installed: adding its Corgi mod" "$state"

  status=0
  state="$(new_app_state plugin-no-app)"
  publish_release "$state" "corgi $version"
  rm "$state/bin/herdr-app"
  PATH="$state/bin:/usr/bin:/bin" run_install "$state" || status=$?
  check "plugin without app: exit status" "0" "$status"
  check "plugin without app: no mod" "no" "$([[ -e "$(app_mod "$state")" ]] && echo yes || echo no)"
  check "plugin without app: says nothing of it" "0" "$(grep -c 'Herdr app' "$state/stderr.log" || true)"
}

# --- test: piped, it fetches the release tag and takes its pins from main ----
test_app_install_piped() {
  local state status=0 repo checkout mod
  state="$(new_app_state app-piped)"
  publish_release "$state" "corgi $version"
  repo="$state/checkout"
  checkout="$state/home/.local/share/corgi"
  mod="$(app_mod "$state")"
  # The release tag lacks its own pins; main gets them in a later commit.
  mv "$repo/checksums/v$version.sha256" "$state/pins"
  git -C "$repo" init -q -b main
  git -C "$repo" add .
  git -C "$repo" -c user.name=test -c user.email=test@example.com commit -q -m release
  git -C "$repo" tag "v$version"
  cp "$state/pins" "$repo/checksums/v$version.sha256"
  git -C "$repo" add checksums
  git -C "$repo" -c user.name=test -c user.email=test@example.com commit -q -m "pins for v$version"

  FAKE_STATE="$state" HOME="$state/home" CORGI_DOWNLOAD_URL="file://$state/release" \
    CORGI_REPO_URL="$repo" PATH="$state/bin:$PATH" \
    sh -s -- --version "$version" <"$repo/herdr-app/install.sh" 2>"$state/stderr.log" || status=$?
  check "piped: exit status" "0" "$status"
  check "piped: checks out the release tag" "v$version" "$(git -C "$checkout" describe --tags --exact-match 2>/dev/null)"
  check_stderr "piped: takes the pins from main" "took the reviewed checksum pins for v$version from origin/main" "$state"
  check "piped: downloads the verified release binary" "corgi $version" "$("$checkout/target/release/corgi" --version 2>/dev/null)"
  check "piped: cargo not run" "0" "$(count_cargo "$state")"
  check "piped: installs the mods" "yes yes" \
    "$([[ -f "$mod/main.js" ]] && echo yes || echo no) $([[ -f "$(projects_mod "$state")/main.js" ]] && echo yes || echo no)"
  check "piped: makes no Corgi space" "" "$(space_calls "$state")"

  # Again, with the checkout in place: fetched, not cloned.
  status=0
  FAKE_STATE="$state" HOME="$state/home" CORGI_DOWNLOAD_URL="file://$state/release" \
    CORGI_REPO_URL="$repo" PATH="$state/bin:$PATH" \
    sh -s -- --version "$version" --cli-only <"$repo/herdr-app/install.sh" 2>"$state/stderr.log" || status=$?
  check "piped again: exit status" "0" "$status"
  check_stderr "piped again: updates the checkout" "updating $checkout" "$state"

  # Without --version it installs the main branch, past the tag, and still
  # takes the pinned download.
  status=0
  echo "# after the release" >>"$repo/herdr-plugin.toml"
  git -C "$repo" -c user.name=test -c user.email=test@example.com commit -q -am "past the release"
  : >"$state/calls.log"
  FAKE_STATE="$state" HOME="$state/home" CORGI_DOWNLOAD_URL="file://$state/release" \
    CORGI_REPO_URL="$repo" PATH="$state/bin:$PATH" \
    sh -s -- --cli-only <"$repo/herdr-app/install.sh" 2>"$state/stderr.log" || status=$?
  check "piped main: exit status" "0" "$status"
  check "piped main: downloads, cargo not run" "0" "$(count_cargo "$state")"
  check_stderr "piped main: installs the prebuilt binary" "installed the prebuilt $asset v$version" "$state"

  status=0
  FAKE_STATE="$state" HOME="$state/home" CORGI_REPO_URL="$repo" PATH="$state/bin:$PATH" \
    sh -s -- --version 9.9.9 <"$repo/herdr-app/install.sh" 2>"$state/stderr.log" || status=$?
  check "piped unknown release: fails" "1" "$status"
  check_stderr "piped unknown release: says so" "could not check out v9.9.9" "$state"
}

