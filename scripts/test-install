#!/usr/bin/env bash
# Shell tests for scripts/install.sh against a fake release and a fake `cargo`.
#
# Run directly: scripts/test-install
#
# Each test gets a fresh plugin checkout (the install script and a manifest)
# and a fake release directory served through CORGI_DOWNLOAD_URL as a file://
# URL. The fake cargo "builds" by writing a marker binary and appends one line
# to calls.log, so a test can tell a download from a source build without
# compiling anything.
#
# HOME is a fresh folder in each test, so linking the command never touches
# the real ~/.local/bin. A test that installs the way Herdr does puts the
# checkout at plugins/.tmp-install-*/checkout and afterwards moves it to
# plugins/github/<id>-<hash>, as Herdr does once the build passes.
set -euo pipefail
unset XDG_BIN_HOME CORGI_BIN_DIR CORGI_LINK

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
install_script="$script_dir/install.sh"

failures=0
tests_run=0

work_root="$(mktemp -d "${TMPDIR:-/tmp}/corgi-install-test.XXXXXX")"
trap 'rm -rf "$work_root"' EXIT

version=0.4.2
plugin_id=io.github.zyrre.corgi

# The fake release is served as a file:// URL, which only curl can fetch.
if ! command -v curl >/dev/null 2>&1; then
  echo "scripts/test-install needs curl" >&2
  exit 1
fi

case "$(uname -s)" in
  Darwin) os=apple-darwin ;;
  *) os=unknown-linux-musl ;;
esac
case "$(uname -m)" in
  arm64 | aarch64) arch=aarch64 ;;
  *) arch=x86_64 ;;
esac
asset="corgi-$arch-$os"

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum "$1" | cut -d ' ' -f 1; }
else
  sha256() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
fi

# --- fixtures ---------------------------------------------------------------

# Prints a fresh state directory holding checkout/, release/ and bin/.
new_state() {
  local state="$work_root/$1"
  mkdir -p "$state/checkout/scripts" "$state/release" "$state/bin" "$state/home"
  cp "$install_script" "$state/checkout/scripts/install.sh"
  cp "$script_dir/link-command.sh" "$state/checkout/scripts/link-command.sh"
  printf 'id = "%s"\nversion = "%s"\n' "$plugin_id" "$version" >"$state/checkout/herdr-plugin.toml"
  : >"$state/calls.log"

  cat >"$state/bin/cargo" <<'FAKE_CARGO'
#!/bin/sh
printf 'cargo %s\n' "$*" >>"$FAKE_STATE/calls.log"
[ -z "${FAKE_CARGO_FAIL:-}" ] || exit 101
mkdir -p target/release
printf '#!/bin/sh\necho "corgi built from source"\n' >target/release/corgi
chmod 755 target/release/corgi
FAKE_CARGO
  chmod 755 "$state/bin/cargo"
  echo "$state"
}

# Publishes a release binary that reports $2 as its version, with a matching
# SHA256SUMS entry.
publish_release() {
  local state="$1" reports="$2" dir="$1/release/v$version"
  mkdir -p "$dir"
  printf '#!/bin/sh\necho "%s"\n' "$reports" >"$dir/$asset"
  printf '#!/bin/sh\necho "corgi %s"\n' "$version" >"$dir/corgi-other-target"
  {
    printf '%s  %s\n' "$(sha256 "$dir/corgi-other-target")" corgi-other-target
    printf '%s  %s\n' "$(sha256 "$dir/$asset")" "$asset"
  } >"$dir/SHA256SUMS"
}

# Like new_state, but the checkout sits where Herdr builds an install;
# $state/checkout links to it.
new_herdr_state() {
  local state
  state="$(new_state "$1")"
  mkdir -p "$state/plugins/.tmp-install-123-456"
  mv "$state/checkout" "$state/plugins/.tmp-install-123-456/checkout"
  ln -s "$state/plugins/.tmp-install-123-456/checkout" "$state/checkout"
  echo "$state"
}

# Where Herdr moves the checkout once the build has passed.
final_checkout() {
  local hash
  hash="$(printf %s "$plugin_id" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c 1-12)"
  echo "$(cd "$1/plugins" && pwd -P)/github/$plugin_id-$hash"
}

# Does what Herdr does after a passing build.
finish_herdr_install() {
  local state="$1" final
  final="$(final_checkout "$state")"
  mkdir -p "$(dirname "$final")"
  mv "$state/plugins/.tmp-install-123-456/checkout" "$final"
  ln -sfn "$final" "$state/checkout"
}

# What the corgi command in bin folder $1 says, run through its link.
command_version() {
  "$1/corgi" --version 2>/dev/null || echo "no corgi command"
}

link_of() {
  if [[ -L "$1" ]]; then readlink "$1"; else echo "not a link"; fi
}

make_git_checkout() {
  local checkout="$1/checkout"
  git -C "$checkout" init -q
  git -C "$checkout" add .
  git -C "$checkout" -c user.name=test -c user.email=test@example.com commit -q -m release
  git -C "$checkout" tag "v$version"
  echo "# after the release" >>"$checkout/herdr-plugin.toml"
  git -C "$checkout" -c user.name=test -c user.email=test@example.com commit -q -am "past the release"
}

run_install() {
  local state="$1"
  FAKE_STATE="$state" \
  HOME="$state/home" \
  CORGI_DOWNLOAD_URL="file://$state/release" \
  PATH="$state/bin:$PATH" \
  sh "$state/checkout/scripts/install.sh" 2>"$state/stderr.log"
}

installed() {
  "$1/checkout/target/release/corgi" --version 2>/dev/null || echo "nothing installed"
}

count_cargo() {
  grep -c '^cargo build --release --locked$' "$1/calls.log" || true
}

leftover_downloads() {
  find "$1/checkout/target/release" -name '.download.*' 2>/dev/null | wc -l | tr -d ' '
}

check() {
  local description="$1" expected="$2" actual="$3"
  tests_run=$((tests_run + 1))
  if [[ "$expected" != "$actual" ]]; then
    echo "FAIL: $description (expected [$expected], got [$actual])" >&2
    failures=$((failures + 1))
  else
    echo "ok: $description"
  fi
}

check_stderr() {
  local description="$1" pattern="$2" state="$3"
  if grep -qF -- "$pattern" "$state/stderr.log"; then
    check "$description" found found
  else
    check "$description" "[$pattern] in stderr" "$(cat "$state/stderr.log")"
  fi
}

# --- test: the matching release binary is downloaded and verified ----------
test_downloads_release_binary() {
  local state status=0
  state="$(new_state download)"
  publish_release "$state" "corgi $version"

  run_install "$state" || status=$?
  check "download: exit status" "0" "$status"
  check "download: installs the release binary" "corgi $version" "$(installed "$state")"
  check "download: cargo not run" "0" "$(count_cargo "$state")"
  check "download: no download folder left behind" "0" "$(leftover_downloads "$state")"
  check_stderr "download: says what it installed" "installed the prebuilt $asset v$version" "$state"
}

# --- test: a clean git checkout past the release commit still downloads ----
test_clean_checkout_past_tag_downloads() {
  local state status=0
  state="$(new_state past-tag)"
  publish_release "$state" "corgi $version"
  make_git_checkout "$state"

  run_install "$state" || status=$?
  check "past tag: exit status" "0" "$status"
  check "past tag: installs the release binary" "corgi $version" "$(installed "$state")"
  check "past tag: cargo not run" "0" "$(count_cargo "$state")"
}

# --- test: uncommitted changes build from source ---------------------------
test_dirty_checkout_builds_from_source() {
  local state status=0
  state="$(new_state dirty)"
  publish_release "$state" "corgi $version"
  make_git_checkout "$state"
  echo "# local edit" >>"$state/checkout/scripts/install.sh"

  run_install "$state" || status=$?
  check "dirty checkout: exit status" "0" "$status"
  check "dirty checkout: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "dirty checkout: says why" "this checkout has uncommitted changes" "$state"
}

# --- test: CORGI_BUILD=source skips the download ---------------------------
test_forced_source_build() {
  local state status=0
  state="$(new_state forced-source)"
  publish_release "$state" "corgi $version"

  CORGI_BUILD=source run_install "$state" || status=$?
  check "forced source: exit status" "0" "$status"
  check "forced source: builds from source" "corgi built from source" "$(installed "$state")"
  check "forced source: cargo run once" "1" "$(count_cargo "$state")"
  check_stderr "forced source: says why" "CORGI_BUILD=source is set" "$state"
}

# --- test: a checksum mismatch builds from source --------------------------
test_checksum_mismatch_builds_from_source() {
  local state status=0
  state="$(new_state checksum)"
  publish_release "$state" "corgi $version"
  echo "tampered" >>"$state/release/v$version/$asset"

  run_install "$state" || status=$?
  check "checksum mismatch: exit status" "0" "$status"
  check "checksum mismatch: builds from source" "corgi built from source" "$(installed "$state")"
  check "checksum mismatch: no download folder left behind" "0" "$(leftover_downloads "$state")"
  check_stderr "checksum mismatch: says why" "does not match its SHA256SUMS entry" "$state"
}

# --- test: a release without this platform's binary builds from source -----
test_missing_asset_builds_from_source() {
  local state status=0
  state="$(new_state missing-asset)"
  publish_release "$state" "corgi $version"
  grep -v -- "$asset" "$state/release/v$version/SHA256SUMS" >"$state/sums" || true
  mv "$state/sums" "$state/release/v$version/SHA256SUMS"

  run_install "$state" || status=$?
  check "missing asset: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "missing asset: says why" "the v$version release has no $asset" "$state"
}

# --- test: no release for this version builds from source ------------------
test_missing_release_builds_from_source() {
  local state status=0
  state="$(new_state missing-release)"

  run_install "$state" || status=$?
  check "missing release: exit status" "0" "$status"
  check "missing release: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "missing release: says why" "could not download" "$state"
}

# --- test: a binary reporting another version builds from source -----------
test_wrong_version_builds_from_source() {
  local state status=0
  state="$(new_state wrong-version)"
  publish_release "$state" "corgi 0.0.1"

  run_install "$state" || status=$?
  check "wrong version: builds from source" "corgi built from source" "$(installed "$state")"
  check_stderr "wrong version: says why" "is not $version (it said: corgi 0.0.1)" "$state"
}

# --- test: a failing cargo build fails the install --------------------------
test_cargo_failure_fails_install() {
  local state status=0
  state="$(new_state cargo-fails)"

  FAKE_CARGO_FAIL=1 CORGI_BUILD=source run_install "$state" || status=$?
  check "cargo fails: exit status is cargo's" "101" "$status"
}

# --- test: building from source without cargo says so ----------------------
test_no_cargo_fails_clearly() {
  if [ -e /usr/bin/cargo ] || [ -e /bin/cargo ]; then
    echo "skip: no cargo (cargo is installed system-wide)"
    return
  fi
  local state status=0
  state="$(new_state no-cargo)"
  rm "$state/bin/cargo"

  CORGI_BUILD=source PATH="/usr/bin:/bin" run_install "$state" || status=$?
  check "no cargo: exits non-zero" "1" "$status"
  check_stderr "no cargo: says cargo is missing" "cargo is not installed" "$state"
}

# --- test: a Herdr install links the command to the final checkout ---------
test_herdr_install_links_command() {
  local state status=0 bin
  state="$(new_herdr_state link)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"

  run_install "$state" || status=$?
  check "link: exit status" "0" "$status"
  check "link: links the final checkout's binary by its absolute path" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$bin/corgi")"
  check_stderr "link: says the folder is not on PATH" \
    "linked $bin/corgi, but $bin is not on your PATH" "$state"
  finish_herdr_install "$state"
  check "link: corgi --version runs through the link" "corgi $version" "$(command_version "$bin")"
}

# --- test: a source build links the command too ----------------------------
test_source_build_links_command() {
  local state status=0 bin
  state="$(new_herdr_state link-source)"
  bin="$state/home/.local/bin"

  CORGI_BUILD=source run_install "$state" || status=$?
  finish_herdr_install "$state"
  check "link after source build: exit status" "0" "$status"
  check "link after source build: runs the built binary" \
    "corgi built from source" "$(command_version "$bin")"
}

# --- test: no PATH hint when the folder is on PATH -------------------------
test_link_on_path_has_no_hint() {
  local state status=0
  state="$(new_herdr_state link-on-path)"
  publish_release "$state" "corgi $version"

  PATH="$state/home/.local/bin:$PATH" run_install "$state" || status=$?
  check "on PATH: exit status" "0" "$status"
  check "on PATH: no hint" "0" "$(grep -c 'not on your PATH' "$state/stderr.log" || true)"
  check_stderr "on PATH: says it linked" "linked $state/home/.local/bin/corgi" "$state"
}

# --- test: a link to an older install is replaced --------------------------
test_link_to_older_install_replaced() {
  local state status=0 bin
  state="$(new_herdr_state link-older)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  ln -s "$(cd "$state/plugins" && pwd -P)/github/old-checkout/target/release/corgi" "$bin/corgi"

  run_install "$state" || status=$?
  check "older link: exit status" "0" "$status"
  check "older link: now links the new checkout" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$bin/corgi")"
}

# --- test: a broken link elsewhere is replaced, a working one is kept ------
test_links_elsewhere() {
  local state status=0 bin
  state="$(new_herdr_state link-broken)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  ln -s "$state/gone/corgi" "$bin/corgi"

  run_install "$state" || status=$?
  check "broken link: exit status" "0" "$status"
  check "broken link: replaced" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$bin/corgi")"

  status=0
  state="$(new_herdr_state link-working)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  printf '#!/bin/sh\necho "my own corgi"\n' >"$state/my-corgi"
  chmod 755 "$state/my-corgi"
  ln -s "$state/my-corgi" "$bin/corgi"

  run_install "$state" || status=$?
  check "working link: exit status" "0" "$status"
  check "working link: kept" "$state/my-corgi" "$(link_of "$bin/corgi")"
  check_stderr "working link: says so" "left $bin/corgi alone: it links $state/my-corgi" "$state"
}

# --- test: a file or a folder in the way is left alone ---------------------
test_file_or_folder_left_alone() {
  local state status=0 bin
  state="$(new_herdr_state link-file)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin"
  echo "mine" >"$bin/corgi"

  run_install "$state" || status=$?
  check "file in the way: exit status" "0" "$status"
  check "file in the way: installs anyway" "corgi $version" "$(installed "$state")"
  check "file in the way: kept" "mine" "$(cat "$bin/corgi")"
  check_stderr "file in the way: says so" "left $bin/corgi alone: it is not a link" "$state"

  status=0
  state="$(new_herdr_state link-folder)"
  bin="$state/home/.local/bin"
  publish_release "$state" "corgi $version"
  mkdir -p "$bin/corgi"

  run_install "$state" || status=$?
  check "folder in the way: exit status" "0" "$status"
  check "folder in the way: kept" "folder" "$([[ -d "$bin/corgi" && ! -L "$bin/corgi" ]] && echo folder)"
  check "folder in the way: nothing linked inside it" "0" "$(find "$bin/corgi" -mindepth 1 | wc -l | tr -d ' ')"
}

# --- test: CORGI_LINK=0 and CORGI_BIN_DIR ----------------------------------
test_link_opt_out_and_override() {
  local state status=0
  state="$(new_herdr_state link-opt-out)"
  publish_release "$state" "corgi $version"

  CORGI_LINK=0 run_install "$state" || status=$?
  check "CORGI_LINK=0: exit status" "0" "$status"
  check "CORGI_LINK=0: nothing linked" "no" "$([[ -e "$state/home/.local" ]] && echo yes || echo no)"

  status=0
  state="$(new_herdr_state link-override)"
  publish_release "$state" "corgi $version"

  CORGI_BIN_DIR="$state/my bin" run_install "$state" || status=$?
  check "CORGI_BIN_DIR: exit status" "0" "$status"
  check "CORGI_BIN_DIR: links there" \
    "$(final_checkout "$state")/target/release/corgi" "$(link_of "$state/my bin/corgi")"
  check "CORGI_BIN_DIR: not in ~/.local/bin" "no" "$([[ -e "$state/home/.local" ]] && echo yes || echo no)"
}

# --- test: a link that cannot be made only warns ---------------------------
test_link_failure_only_warns() {
  local state status=0
  state="$(new_herdr_state link-fails)"
  publish_release "$state" "corgi $version"
  echo "not a folder" >"$state/home/.local"

  run_install "$state" || status=$?
  check "link fails: exit status" "0" "$status"
  check "link fails: installs anyway" "corgi $version" "$(installed "$state")"
  check_stderr "link fails: says so" "could not link $state/home/.local/bin/corgi" "$state"
}

# --- test: outside a Herdr install nothing is linked -----------------------
test_no_link_outside_herdr() {
  local state status=0
  state="$(new_state link-outside)"
  publish_release "$state" "corgi $version"

  run_install "$state" || status=$?
  check "outside Herdr: exit status" "0" "$status"
  check "outside Herdr: nothing linked" "no" "$([[ -e "$state/home/.local" ]] && echo yes || echo no)"
}

test_downloads_release_binary
test_clean_checkout_past_tag_downloads
test_dirty_checkout_builds_from_source
test_forced_source_build
test_checksum_mismatch_builds_from_source
test_missing_asset_builds_from_source
test_missing_release_builds_from_source
test_wrong_version_builds_from_source
test_cargo_failure_fails_install
test_no_cargo_fails_clearly
test_herdr_install_links_command
test_source_build_links_command
test_link_on_path_has_no_hint
test_link_to_older_install_replaced
test_links_elsewhere
test_file_or_folder_left_alone
test_link_opt_out_and_override
test_link_failure_only_warns
test_no_link_outside_herdr

echo
echo "$tests_run tests run, $failures failed"
[[ "$failures" -eq 0 ]]
